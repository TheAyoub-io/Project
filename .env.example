# .env.example
# Copiez ce fichier en .env sur votre serveur et modifiez les valeurs.

# ================================
# Base de données (PostgreSQL)
# ================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=votre_mot_de_passe_securise
POSTGRES_DB=internat_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ================================
# API Backend (FastAPI)
# ================================
SECRET_KEY=votre_cle_secrete_super_longue_et_aleatoire
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=https://votre-domaine.com

# ================================
# Emails (SMTP)
# ================================
EMAILS_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_d_application

# ================================
# Paiements (Stripe - Optionnel)
# ================================
STRIPE_SECRET_KEY=sk_test_...
